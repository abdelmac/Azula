# Copier avec python scripts/setup_env.py : secrets aléatoires, aucun écrasement.
ENVIRONMENT=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
DB_NAME=azula
DB_USER=azula
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# Hébergement : DATABASE_URL remplace les champs DB_* de connexion si renseignée.
# DATABASE_URL=postgresql://...
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/run/secrets/postgres-ca.pem
# DB_CONN_MAX_AGE=60
# DB_TRANSACTION_POOLING=0
# Serveur HTTP derrière un proxy HTTPS explicitement choisi :
# TRUST_HTTPS_PROXY=1
# TRUSTED_PROXY=adresse-du-proxy
# PORT=8000
ALLOW_DEMO_DATA=0

# Abonnements Azula : aucun tarif ni encaissement activé par défaut.
# Utiliser d'abord une installation de test distincte et des clés Stripe de test.
BILLING_ENABLED=0
BILLING_PUBLIC_URL=
STRIPE_LIVE_MODE=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
